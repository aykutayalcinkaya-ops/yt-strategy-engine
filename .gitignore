# ── Gizli bilgiler ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# ── Sanal ortamlar ────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Dağıtım / paketleme ───────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Test ──────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Loglar / önbellek ─────────────────────────────────────────────────
*.log
logs/
data/raw/
data/cache/
.analizler_state.json

# ── PyInstaller ───────────────────────────────────────────────────────
*.spec.bak

# ── Üretilen çıktılar (klasör yapısı izlenir, içerik izlenmez) ────────
outputs/scripts/*
outputs/senaryolar/*
!outputs/scripts/.gitkeep
!outputs/senaryolar/.gitkeep

# ── Kullanıcı verisi (CSV/Excel dosyaları gizli kalır) ────────────────
Analizler/*.csv
Analizler/*.xlsx
Analizler/*.xls
!Analizler/ORNEK_FORMAT.csv

# ── İşletim sistemi ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
