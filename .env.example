# ─────────────────────────────────────────────────────────────────────
#  .env.example  —  yt-manual-analyzer yapılandırma şablonu
#  Kullanım: cp .env.example .env  →  değerleri doldur
# ─────────────────────────────────────────────────────────────────────

# ── Zorunlu ───────────────────────────────────────────────────────────
# Anthropic API anahtarı → https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── İsteğe bağlı ──────────────────────────────────────────────────────
# YouTube Data API v3 (trend analizi ve kanal verisi için)
# → https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# ── Claude model ayarları ─────────────────────────────────────────────
# Kullanılabilir modeller:
#   claude-sonnet-4-6          → önerilen (hız/kalite dengesi)
#   claude-opus-4-7            → maksimum kalite, daha yavaş
#   claude-haiku-4-5-20251001  → en hızlı, kısa içerikler için
CLAUDE_MODEL=claude-sonnet-4-6

# Genel API çağrıları için maksimum token
MAX_TOKENS=8192

# Senaryo üretimi için maksimum token (≥16000 önerilir)
SCENARIO_MAX_TOKENS=16000

# ── YouTube API ayarları (YOUTUBE_API_KEY gerektirir) ─────────────────
YOUTUBE_MAX_RESULTS=50
YOUTUBE_REGION_CODE=TR
YOUTUBE_LANGUAGE=tr

# ── Çıktı klasörü ─────────────────────────────────────────────────────
OUTPUT_DIR=outputs
